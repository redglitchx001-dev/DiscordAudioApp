<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#36393f"
    tools:context=".MainActivity">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Premium Floating Action Button (The "Mini Bubble") -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabSettings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:src="@android:drawable/ic_menu_preferences"
        app:backgroundTint="#5865F2"
        app:tint="#FFFFFF"
        android:contentDescription="Audio Settings" />

    <!-- Bottom Sheet for Premium Settings -->
    <LinearLayout
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bottom_sheet_bg"
        android:orientation="vertical"
        android:padding="24dp"
        app:behavior_hideable="true"
        app:behavior_peekHeight="0dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        android:elevation="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Premium Audio Control 🎧"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:layout_marginBottom="24dp" />

        <!-- Volume Control -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Microphone Boost (Decibels)"
            android:textColor="#B9BBBE"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />
        <SeekBar
            android:id="@+id/volumeBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="300"
            android:progress="100"
            android:progressTint="#5865F2"
            android:thumbTint="#5865F2"
            android:layout_marginBottom="16dp" />

        <!-- Echo Control -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Echo Effect / Reverb"
            android:textColor="#B9BBBE"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />
        <SeekBar
            android:id="@+id/echoBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="0"
            android:progressTint="#EB459E"
            android:thumbTint="#EB459E"
            android:layout_marginBottom="24dp" />

        <!-- Load MP3 -->
        <Button
            android:id="@+id/btnLoadMp3"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Troll Mic (Load MP3)"
            android:backgroundTint="#3BA55C"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnStopMp3"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Stop MP3"
            android:backgroundTint="#ED4245"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
